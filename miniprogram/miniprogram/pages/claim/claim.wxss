/* ===== 领取页 · BYWOOD ===== */

/* 奖励色块：纯色，块内纯白，无渐变无阴影 */
.reward-block {
  margin-top: 16rpx;
  padding: 56rpx 44rpx 44rpx;
  text-align: center;
  color: #ffffff;
}
.rb-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.rb-amount {
  margin: 28rpx 0 6rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #ffffff;
}
.rb-sign { font-size: 44rpx; margin-right: 8rpx; font-weight: 600; }
.rb-num { font-size: 120rpx; line-height: 1.05; font-weight: 700; }
.rb-remark {
  font-size: 26rpx;
  color: #ffffff;
  margin-top: 10rpx;
}
.rb-btn {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: #ffffff;
  color: var(--block-red);
  transition: transform 120ms ease-out;
}
.rb-btn::after { border: none; }
.rb-btn:active { transform: scale(0.98); }
.rb-btn[disabled] { background: rgba(255, 255, 255, 0.85); color: rgba(217, 35, 43, 0.55); }
.rb-btn-blue { color: var(--block-blue); }
.rb-btn-blue[disabled] { background: #ffffff; color: var(--block-blue); }
.rb-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  min-height: 34rpx;
}
.rb-fine {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}
.after-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
}

/* ===== 状态页（空/错/加载）：裸线性图标 + 两行文案 + 次按钮 ===== */
.state {
  padding: 96rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-icon { margin-bottom: 28rpx; }
.state-t1 {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-dark);
}
.state-t2 {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-light);
  text-align: center;
}
.state-detail {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-faint);
  text-align: center;
  word-break: break-all;
  max-height: 200rpx;
  overflow: hidden;
}
.state-btn {
  margin-top: 40rpx;
  width: 320rpx;
}

/* ===== 员工入口（白底描边块） ===== */
.join { margin-top: 8rpx; }
.join-t { font-size: 30rpx; font-weight: 600; }
.join-s { font-size: 26rpx; margin-top: 4rpx; }
.openid-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--fill);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
}
.openid-text {
  flex: 1;
  word-break: break-all;
  font-size: 24rpx;
  color: var(--text-light);
}
.openid-copy {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 10rpx 14rpx;
}
