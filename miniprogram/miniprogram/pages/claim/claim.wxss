/* ===== 领取页 · BYWOOD v6.3（token 与构件见 app.wxss）=====
   一屏一句判断：待领时是深青证据块里的那个金额（n1），到账时是青面上的「已到账」。
   间距只取 8/16/24/32/40/48/64 rpx；字只取七个字级 + 两级数字 */

/* ① 发放方：品牌 + 发放员工，放在奖励块上方（链接领取最先回答"这是谁发的"） */
.issuer { display: flex; align-items: baseline; gap: 16rpx; padding: 16rpx 8rpx 24rpx; }
.issuer-brand { font-size: 30rpx; font-weight: 700; color: var(--color-text-dark); }
.issuer-who { font-size: 26rpx; color: var(--color-text-light); }

/* ===== 奖励块 =====
   领取前 = 深青证据块：白字三档、白 14% 线，块里唯一的按钮标志青底墨字；
   到账后 = 标志青承诺块：墨字三档、墨 14% 线、墨版轮印（青面三件套）。
   块内文字一律读所在底的变量（下面两组 --rb-*），子元素不写第二套色 */
.reward-block {
  position: relative; /* 轮印定位基准 */
  padding: 40rpx 40rpx 40rpx;
  --rb-c1: var(--color-on-deep);
  --rb-c2: var(--color-on-deep-2);
  --rb-c3: var(--color-on-deep-3);
  --rb-line: var(--color-line-on-deep);
  --rb-bg: var(--color-deep);
  color: var(--rb-c2);
}
/* 页面 wxss 晚于 app.wxss 生效：复合选择器把青面的墨字搭档压回来 */
.reward-block.field-brand {
  --rb-c1: var(--color-ink);
  --rb-c2: var(--color-ink-2);
  --rb-c3: var(--color-ink-3);
  --rb-line: var(--color-line-on-field);
  --rb-bg: var(--color-field-brand);
  color: var(--rb-c2);
}
/* 到账块角落的轮印（v5.5 闲章）。kit 的 .round-seal 默认 text-dark，深色模式会翻白——青面上一律墨 */
.rb-seal {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  color: var(--color-ink);
}

/* ② 状态：标签档（sm 600），到账时前面一个描边勾 */
.rb-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 42rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--rb-c2);
}
/* 描边画勾：小确认（≤64px）用回弹曲线，淡入 + 轻微上移，只这一次；色块从深青换成青面本身已经够醒目 */
.rb-check {
  flex: none;
  width: 28rpx;
  height: 14rpx;
  margin: 0 4rpx 8rpx;
  border-left: 5rpx solid var(--rb-c1);
  border-bottom: 5rpx solid var(--rb-c1);
  transform: rotate(-45deg);
  animation: checkIn 320ms var(--ease-overshoot) 120ms backwards;
}
@keyframes checkIn {
  from { opacity: 0; transform: translateY(8rpx) rotate(-45deg) scale(0.6); }
  to { opacity: 1; transform: translateY(0) rotate(-45deg) scale(1); }
}

/* 金额：n1（80rpx / 800），¥ 跟着数字走（0.4em 显示字） */
.rb-amount { margin-top: 16rpx; color: var(--rb-c1); }
/* 金额未核验：占住金额的位置但不给数字（d3 档，比 n1 低两档，读得出"不是金额"） */
.rb-unverified { display: block; font-size: 34rpx; font-weight: 900; line-height: 88rpx; }
/* 大额拆单：第 N/M 笔 · 已到账累计 */
.rb-multi { margin-top: 8rpx; font-size: 24rpx; line-height: 1.5; color: var(--rb-c2); }

/* 事由 / 到账：收款单的行表——标签 c2 / 内容 c1 600，行间线跟随所在底 */
.rb-meta { margin-top: 32rpx; padding-top: 8rpx; border-top: 1px solid var(--rb-line); }
.rb-row { display: flex; justify-content: space-between; gap: 24rpx; padding-top: 16rpx; font-size: 26rpx; line-height: 1.5; }
.rb-k { flex: none; color: var(--rb-c2); }
.rb-v { font-weight: 600; text-align: right; word-break: break-all; color: var(--rb-c1); }
/* 到账凭证的单号：标签和「复制」一行，32 位单号单独一行靠右。
   复制 = 青面上的小控件：墨 14% 线框、内件圆角；能点的范围靠内边距撑到 88rpx，负外边距抵回去，行高不变 */
.rb-row-copy { align-items: center; }
.rb-rid { padding-top: 4rpx; font-size: 24rpx; font-weight: 600; line-height: 1.5; text-align: right; word-break: break-all; color: var(--rb-c1); }
.rb-copy { flex: none; padding: 22rpx 0 22rpx 20rpx; margin: -22rpx 0; min-width: 88rpx; box-sizing: border-box; text-align: right; }
.rb-copy-t {
  display: inline-block;
  padding: 0 16rpx;
  border: 1px solid var(--rb-line);
  border-radius: calc(var(--radius-control) - 8rpx);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--rb-c1);
  transition: background-color var(--duration-press) var(--ease-out);
}
.rb-copy.is-press .rb-copy-t { background: var(--rb-line); }

/* ③ 进度轮尺：kit 的 .round-ruler 默认主色，块内改跟随主字；当前步内圈挖空用块底色 */
.rb-steps { margin-top: 40rpx; }
.rb-steps .round-ruler { color: var(--rb-c1); }
.rb-steps .r-now::after { border-color: var(--rb-bg); }
.rb-steps-t { display: flex; justify-content: space-between; margin-top: 12rpx; font-size: 24rpx; color: var(--rb-c2); }

/* ④ 主按钮：深青块上标志青底墨字（app.wxss .btn-on-deep），整行 96rpx */
.reward-block .btn.rb-btn { margin-top: 48rpx; }
/* 加载中/禁用：深青上的灰底淡字（白 14% 底、白 55% 字），无按下 */
.reward-block .btn.rb-btn[disabled] { background: var(--color-line-on-deep); color: var(--color-on-deep-3); transform: none; }
/* 已确认、查单中：山形弧带跟随块内主字，占住按钮的位置不跳版 */
.rb-wait { margin-top: 48rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; }
.rb-wait .band-spinner .band { background: var(--rb-c1); }
/* 提示：主字档（失败原因、进行中的说明都是要读的信息）；官方确认说明：注档 */
.rb-tip { margin-top: 24rpx; font-size: 26rpx; line-height: 1.6; color: var(--rb-c1); }
.rb-fine { margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; color: var(--rb-c3); }

/* ⑥ 帮助 + 合作记录：奖励块之下的注（mi 档），与块内文字左缘对齐 */
.help { margin-top: 24rpx; padding: 0 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--color-text-light); }
.coop { margin-top: 16rpx; padding: 0 8rpx; font-size: 24rpx; line-height: 1.6; color: var(--color-text-light); }
/* 员工入口：一行文字按钮，靠左 */
.textbtn.staff-entry { margin-top: 24rpx; justify-content: flex-start; padding: 0 8rpx; font-size: 26rpx; }

/* 奖励提醒（白表面）：一行理由在上，按钮在下；开启/拒绝后只剩一行结果 */
.sub { margin-top: 32rpx; }
.sub-t { font-size: 26rpx; line-height: 1.6; color: var(--color-text); }
.btn.sub-btn { margin-top: 24rpx; }
/* 管理员入口：奖励块与档案之后，次按钮 */
.btn.admin-entry { margin-top: 32rpx; }

/* ===== 操作端主页（管理员进门即仪表盘） ===== */
.ahome-lede { padding: 24rpx 8rpx 32rpx; }
/* 深青证据块：可发额度 n1，底部一条白 14% 线隔出累计发放 */
.ah-hero { margin-bottom: 16rpx; padding: 40rpx; }
.ah-label { font-size: 26rpx; font-weight: 600; color: var(--color-on-deep-2); }
.ah-num { margin-top: 16rpx; color: var(--color-on-deep); }
/* 额度告罄：深青块里不加第三种颜色，告警由文案承担 */
.ah-sub { margin-top: 16rpx; font-size: 26rpx; color: var(--color-on-deep); }
.ah-foot {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--color-line-on-deep);
  font-size: 24rpx;
  color: var(--color-on-deep-2);
}
.ah-foot .num { font-weight: 700; color: var(--color-on-deep); }
/* 异常：语义 danger 浅底 + 加深档标题，进门可见、点击直达失败筛选（必须修的，留在出事的地方）。
   大块区域按下只变底色，不缩放 */
.ah-alert { margin-bottom: 16rpx; padding: 28rpx 32rpx; background: var(--color-danger-tint); transition: background-color var(--duration-press) var(--ease-out); }
.ah-alert.is-press { background: var(--color-fill); }
.ah-alert-t { font-size: 30rpx; font-weight: 700; color: var(--color-danger-deep); }
.ah-alert-s { margin-top: 8rpx; font-size: 24rpx; color: var(--color-text-light); }
/* 近 24 小时：两块白表面（判断），数字 42rpx 800（半宽块放得下五位金额），单位 sm 600 */
.ah-minis { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.panel.ah-mini { flex: 1; min-width: 0; padding: 28rpx 32rpx; }
.ahm-label { font-size: 26rpx; color: var(--color-text-light); }
.ahm-num { margin-top: 16rpx; font-size: 42rpx; font-weight: 800; line-height: 1.1; color: var(--color-text-dark); white-space: nowrap; }
.ahm-num .num { font-weight: 800; }
.ahm-u { margin-left: 8rpx; font-size: 26rpx; font-weight: 600; }
.ahm-cur { margin-right: 4rpx; font-size: 26rpx; font-weight: 600; }
.ah-tips { margin-top: 24rpx; font-size: 24rpx; color: var(--color-text-light); text-align: center; }
.ah-total { margin-top: 16rpx; font-size: 24rpx; color: var(--color-text-light); text-align: center; }
.ah-total .num { font-weight: 700; color: var(--color-text-dark); }

@media (prefers-reduced-motion: reduce) {
  .rb-check { animation: none; }
}
