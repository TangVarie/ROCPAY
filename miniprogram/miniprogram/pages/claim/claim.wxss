/* ===== 领取页 · BYWOOD ===== */

/* 奖励色块：纯色，块内纯白，无渐变无阴影 */
.reward-block {
  margin-top: 16rpx;
  padding: 56rpx 44rpx 44rpx;
  text-align: center;
  color: #ffffff;
}
.rb-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.rb-amount {
  margin: 28rpx 0 6rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #ffffff;
}
.rb-sign { font-size: 42rpx; margin-right: 8rpx; font-weight: 600; }
.rb-num { font-size: 120rpx; line-height: 1.05; font-weight: 700; }
.rb-remark {
  font-size: 26rpx;
  color: #ffffff;
  margin-top: 10rpx;
}
/* 大额拆单：共 N 笔 · 合计 提示（红底上白字不降透明度：0.9 白约 4.4:1 踩线，
   纯白 ~5:1 才过小字 4.5:1；层级差交给字号/字重，不牺牲对比度） */
.rb-multi {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.5;
}
.rb-btn {
  margin-top: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  border-radius: var(--r-control);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: #ffffff;
  color: var(--block-red);
  transition: transform 120ms ease-out;
}
.rb-btn::after { border: none; }
.rb-btn:active { transform: scale(0.98); }
.rb-btn[disabled] { background: rgba(255, 255, 255, 0.85); color: rgba(217, 35, 43, 0.55); }
.rb-btn-blue { color: var(--block-blue); }
.rb-btn-blue[disabled] { background: #ffffff; color: var(--block-blue); }
.rb-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
  min-height: 34rpx;
}
.rb-fine {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1.5;
}
.after-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
}

/* ===== 状态页（空/错/加载）：裸线性图标 + 两行文案 + 次按钮 ===== */
.state {
  padding: 96rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-icon { margin-bottom: 28rpx; }
.state-t1 {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-dark);
}
.state-t2 {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-light);
  text-align: center;
}
.state-detail {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  word-break: break-all;
  max-height: 200rpx;
  overflow: hidden;
}
.state-btn {
  margin-top: 40rpx;
  width: 320rpx;
}

/* ===== 员工入口（白底描边块） ===== */
.join { margin-top: 8rpx; }
.join-t { font-size: 30rpx; font-weight: 600; }
.join-s { font-size: 26rpx; margin-top: 4rpx; }
.openid-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--fill);
  border-radius: var(--r-control);
  padding: 22rpx 26rpx;
}
.openid-text {
  flex: 1;
  word-break: break-all;
  font-size: 24rpx;
  color: var(--text-light);
}
.openid-copy {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 10rpx 14rpx;
}

/* ===== 操作端主页（管理员进门即仪表盘） ===== */
.ahome-lede { padding: 24rpx 4rpx 28rpx; }
.ah-hero { margin-bottom: 20rpx; }
.ah-label { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); }
.ah-num { font-size: 80rpx; font-weight: 700; color: #ffffff; line-height: 1.15; margin-top: 8rpx; }
.ah-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); margin-top: 8rpx; }
.ah-low { color: #ffb0b0; } /* 额度告罄浅红 */
/* 异常警示块：浅红底 + 冷酒红标题，进门可见、点击直达失败筛选 */
.ah-alert { margin-bottom: 20rpx; padding: 26rpx 30rpx; }
.ah-alert:active { opacity: 0.85; }
.ah-alert-t { font-size: 30rpx; font-weight: 700; color: var(--danger-dark); }
.ah-alert-s { font-size: 24rpx; color: var(--text-light); margin-top: 4rpx; }
.ah-minis { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.ah-mini { flex: 1; padding: 22rpx 26rpx; }
.ahm-label { font-size: 24rpx; color: var(--text-light); }
.ahm-num { font-size: 42rpx; font-weight: 700; line-height: 1.2; margin-top: 2rpx; }
.ah-tips { margin-top: 20rpx; text-align: center; font-size: 24rpx; letter-spacing: 1rpx; }

/* ===== 到账仪式感（克制版：纯 CSS，无渐变无阴影） ===== */
/* 描边画勾：与 .cb.on::after 同款，弹性放大入场 */
.rb-checkwrap { display: flex; justify-content: center; margin-bottom: 12rpx; }
.rb-check {
  width: 52rpx;
  height: 26rpx;
  border-left: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(-45deg);
  animation: checkPop 420ms cubic-bezier(0.2, 1.4, 0.4, 1) backwards;
}
@keyframes checkPop {
  from { opacity: 0; transform: rotate(-45deg) scale(0.3); }
  to { opacity: 1; transform: rotate(-45deg) scale(1); }
}
/* 色块红转蓝时一次轻微呼吸 */
.reward-block.celebrate { animation: blockBreath 420ms ease-out; }
@keyframes blockBreath {
  0% { transform: scale(1); }
  40% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

/* ===== 合作档案 · 等级卡（开屏与领取页都展示） ===== */
.lvcard { margin-top: 24rpx; }
.lv-line1 { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.lv-nums { font-size: 26rpx; }
.lv-next { font-size: 24rpx; margin-top: 10rpx; }
