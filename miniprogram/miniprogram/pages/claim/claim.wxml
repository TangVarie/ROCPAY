<!-- 开屏放级联容器之外（fixed 浮层不进 .stagger-in）；只在冷启动亮（app.js onLaunch 置位）。
     ready 绑 entryReady：令牌流程等校验接口回来、直接打开等身份落定（含出错），开屏等它到了再淡出，
     不叠两个等待屏。不能绑 mode——链接进入时 mode 在发请求前就是 token 了 -->
<splash ready="{{entryReady}}" />
<view class="page stagger-in">

  <!-- 识别中：品牌山形弧带加载动效（四条弧带由下至上逐层点亮） -->
  <state-view wx:if="{{mode==='loading'}}" icon="spinner" title="正在为你查看奖励" desc="通常只需要一两秒" />

  <!-- 连接失败 -->
  <state-view wx:if="{{mode==='error'}}" icon="alert" title="暂时连不上服务" desc="服务可能正在启动，点下方按钮再试一次" detail="{{message}}" btn-text="再试一次" bind:action="retry" />

  <block wx:if="{{mode==='token' || mode==='mine'}}">
    <!-- 令牌已终结（过期/已领/已撤回）：直接给终态，不再出现可点的领取按钮 -->
    <state-view wx:if="{{tokenGone}}" icon="alert" title="无法领取" desc="{{tokenGone}}" />

    <!-- 可信收款单：发放方 → 金额与事由 → 当前状态 → 主按钮 → 官方确认说明 → 帮助。
         外部链接最怕"这是谁发的、为什么、钱到哪"，这三件事先讲清 -->
    <block wx:else>
      <!-- ① 发放方：品牌 + 发放员工 -->
      <view class="issuer">
        <text class="issuer-brand">梨响ROC</text>
        <text class="issuer-who">{{issuer ? issuer + ' 发给你' : '发给你的奖励'}}</text>
      </view>

      <!-- 奖励块：领取前 = 深青证据块（白字；块里的按钮标志青底墨字）/ 到账后 = 标志青承诺块（青面三件套：墨字 + 墨版轮印）。
           状态以查单为准：点了确认 ≠ 到账，只有 ok 才翻青面；dead 是失败/撤回终态，留在深青不庆祝 -->
      <view class="reward-block block {{status==='ok' ? 'field-brand' : 'block-deep'}}">
        <!-- 到账 = 结算通知/里程碑：角落落一枚轮印（v5.5 闲章，内容固定不计数；青面上墨色），一屏一枚 -->
        <view class="round-seal rb-seal" wx:if="{{status==='ok'}}" aria-hidden="true">
          <view class="mark"><view class="b b1"></view><view class="b b2"></view><view class="b b3"></view><view class="b b4"></view></view>
          <text class="n">扶摇</text><text class="r">ROC</text><text class="u">结构性复利</text>
        </view>
        <!-- ② 当前状态：标题就是状态；到账时前面落一个勾 -->
        <view class="rb-label {{status==='dead' ? 'rb-label-dead' : ''}}">
          <view class="rb-check" wx:if="{{status==='ok'}}" aria-hidden="true"></view>
          <text>{{ status==='ok' ? (claimedCount > 1 ? '全部到账' : '已到账微信零钱') : (status==='between' || status==='nextfail') ? '本笔已到账' : (status==='confirming' || status==='arriving') ? '已确认收款 · 到账中' : status==='dead' ? deadTitle : resume ? '待确认收款' : '待领取' }}</text>
        </view>
        <!-- 金额（n1）：链接金额没经后端核验（校验接口不可达）时不上屏任何数字 -->
        <view class="rb-amount" wx:if="{{mode==='token' && amtUnverified}}"><text class="rb-unverified">金额待核验</text></view>
        <view class="rb-amount {{status==='dead' ? 'n2 rb-amount-dead' : 'n1'}}" wx:else><text class="unit">¥</text><text class="rb-num">{{ mode==='mine' ? mineAmt : amtText }}</text></view>
        <!-- 大额拆单：一人多笔逐笔领，进度与已到账累计一直可见 -->
        <view class="rb-multi" wx:if="{{mode==='mine' && claimedCount + minePendCount > 1 && status!=='ok'}}">第 {{claimedCount + 1}}/{{claimedCount + minePendCount}} 笔{{claimedCount > 0 ? ' · 已到账 ¥' + claimedYuan : ''}}</view>
        <!-- 事由与去向：收款单的行表（标签 / 内容），行间线跟随所在底 -->
        <view class="rb-meta">
          <view class="rb-row" wx:if="{{mode==='mine' ? mineRemark : remark}}"><text class="rb-k">事由</text><text class="rb-v">{{ mode==='mine' ? mineRemark : remark }}</text></view>
          <view class="rb-row"><text class="rb-k">到账</text><text class="rb-v">微信零钱</text></view>
          <!-- 到账凭证：到账后多两行——到账时间、单号（可复制，员工在台账里搜这个单号就能找到这笔）。
               单号是 32 位，单独占一行才放得下；多笔时显示第一笔的单号，标签注明共几笔，复制出来是全部单号 -->
          <block wx:if="{{status==='ok' && receipt}}">
            <view class="rb-row" wx:if="{{receipt.time}}"><text class="rb-k">到账时间</text><text class="rb-v num">{{receipt.time}}</text></view>
            <view class="rb-row rb-row-copy">
              <text class="rb-k">单号{{receipt.count > 1 ? '（共 ' + receipt.count + ' 笔，复制得到全部）' : ''}}</text>
              <view class="rb-copy" bindtap="copyReceipt" hover-class="is-press" aria-role="button" aria-label="复制单号"><text class="rb-copy-t">复制</text></view>
            </view>
            <view class="rb-rid"><text class="num" user-select="{{true}}">{{receipt.rid}}</text></view>
          </block>
        </view>

        <!-- ③ 进度：分段进度条三步——领取 → 微信确认 → 到账。走过的和当前步的色条实心，没到的只剩轨道；
             当前步的字加粗。颜色读所在底（深青块上白、青面上墨） -->
        <view class="stepbar rb-steps" wx:if="{{status!=='dead' && !(mode==='token' && amtUnverified)}}" aria-hidden="true">
          <view class="sb-i {{ (status==='idle' || status==='loading' || status==='fail') && !resume ? 'now' : 'done' }}"><view class="sb-bar"></view><text class="sb-t">领取</text></view>
          <view class="sb-i {{ (status==='idle' || status==='loading' || status==='fail') ? (resume ? 'now' : '') : 'done' }}"><view class="sb-bar"></view><text class="sb-t">微信确认</text></view>
          <view class="sb-i {{ (status==='ok' || status==='between' || status==='nextfail') ? 'done' : (status==='confirming' || status==='arriving') ? 'now' : '' }}"><view class="sb-bar"></view><text class="sb-t">到账</text></view>
        </view>

        <!-- ④ 主按钮（深青块上：标志青底墨字）：只在领取前/可重试时出现。金额未核验给"重新连接"；入账查询超时给"刷新到账结果"；
             到账/失败终态不渲染按钮（青面上只许墨字/主色字，一颗禁用按钮既无动作也无合法配色） -->
        <button wx:if="{{mode==='token' && amtUnverified}}" class="btn btn-on-deep btn-block rb-btn" hover-class="is-press" bindtap="retryToken" loading="{{verifying}}" disabled="{{verifying}}">重新连接</button>
        <button
          wx:elif="{{status==='idle' || status==='loading' || status==='fail'}}"
          class="btn btn-on-deep btn-block rb-btn"
          hover-class="is-press"
          bindtap="{{ mode==='mine' ? 'onClaimMine' : 'onClaimToken' }}"
          loading="{{status==='loading'}}"
          disabled="{{status==='loading'}}"
        >{{resume ? '继续确认收款' : '领取到微信零钱'}}</button>
        <button wx:elif="{{status==='arriving'}}" class="btn btn-on-deep btn-block rb-btn" hover-class="is-press" bindtap="refreshArrival">刷新到账结果</button>
        <button wx:elif="{{status==='nextfail'}}" class="btn btn-on-deep btn-block rb-btn" hover-class="is-press" bindtap="retryNext">继续领下一笔</button>
        <view class="rb-wait" wx:elif="{{status==='confirming' || status==='between'}}" aria-label="正在处理">
          <view class="band-spinner"><view class="band band-1"></view><view class="band band-2"></view><view class="band band-3"></view><view class="band band-4"></view></view>
        </view>

        <view class="rb-tip" wx:if="{{mode==='token' && amtUnverified}}">{{verifying ? '正在重新连接，核验金额…' : '暂时连不上服务，金额还没核验，点上方按钮再试'}}</view>
        <view class="rb-tip" wx:elif="{{message}}">{{message}}</view>
        <!-- ⑤ 官方确认说明：只在领取前有用；确认之后还挂着就成了过时提示 -->
        <view class="rb-fine" wx:if="{{!amtUnverified && (status==='idle' || status==='loading' || status==='fail')}}">点领取后弹出微信官方「确认收款」，确认后转入微信零钱</view>
      </view>

      <!-- ⑥ 帮助：按状态给一句下一步 -->
      <view class="help">{{ status==='ok' ? '可在微信「我 › 服务 › 钱包 › 零钱」查看这笔入账' : (status==='confirming' || status==='arriving' || status==='between') ? '微信入账通常几秒到几分钟，可下拉刷新，或稍后重新打开本页查看' : '对这笔奖励有疑问，请联系' + (issuer || '给你发奖励的员工') }}</view>

      <!-- 奖励提醒（白表面：一个操作）：到账之后再问（领取前不打扰）。先说为什么，客户主动点才弹系统授权。
           勾过「总是允许」的客户点领取时已静默续上，这里直接显示已开启；勾过「总是拒绝」的直接给去设置的说明 -->
      <view class="sub panel" wx:if="{{status==='ok' && subOn}}">
        <view class="sub-t" wx:if="{{subState==='on'}}">已开启提醒：下一笔奖励发出时，微信会通知你{{subAlways ? '。你选了总是允许，以后每次领取会自动续上' : ''}}</view>
        <view class="sub-t" wx:elif="{{subState==='off'}}">没有开启提醒。之后想开，点右上角「···」›「设置」›「通知管理」打开</view>
        <block wx:else>
          <view class="sub-t">{{subAlways ? '你选过总是允许：点下方按钮直接续上，不会再弹窗' : '下一笔奖励发出时，可以用微信服务通知提醒你（开一次，提醒一次）'}}</view>
          <button class="btn btn-secondary btn-block sub-btn" hover-class="is-press" bindtap="askSubscribe" loading="{{subState==='saving'}}" disabled="{{subState==='saving'}}">有新奖励时提醒我</button>
        </block>
      </view>

      <!-- 合作记录：降为一行注 -->
      <view class="coop" wx:if="{{profile && profile.count > 0}}">合作 {{profile.count}} 次 · 累计到账 ¥{{profile.totalYuan}} · LV{{profile.lv}} {{profile.name}}{{profile.count >= 2 && profile.nextText ? ' · ' + profile.nextText : ''}}</view>

      <!-- 管理员自己领奖励或打开链接时也要能回工作台（原先只有"无奖励"的首页才有入口） -->
      <button class="btn btn-secondary btn-block admin-entry" hover-class="is-press" wx:if="{{isAdmin}}" bindtap="goAdmin">进入工作台</button>
    </block>
  </block>

  <!-- 无奖励 -->
  <block wx:if="{{mode==='empty'}}">
    <!-- 操作端主页：进门即仪表盘——导语一句判断；深青证据块放可发额度（n1，一屏唯一）与累计发放；
         资金异常留在出事的地方（白表面 + 危险记号）；近 24 小时是一张行表（尾值 n2）；一个主按钮 -->
    <block wx:if="{{isAdmin}}">
      <view class="ahome-lede">
        <view class="lede"><view>你好，<text class="em">{{roleLabel || '管理员'}}</text>。</view><view>今天把奖励<text class="em">发给对的人</text>。</view></view>
      </view>

      <view class="block block-deep ah-hero" wx:if="{{adminHome && adminHome.hasQuota}}">
        <view class="ah-label">可发额度 · 剩余</view>
        <view class="ah-num n1">{{adminHome.neg ? '−' : ''}}<text class="unit">¥</text>{{adminHome.remainingYuan}}</view>
        <view class="ah-sub" wx:if="{{adminHome.low}}">额度已用尽，进工作台充值</view>
        <view class="ah-foot" wx:if="{{adminHome.totalAllYuan}}"><text>累计发放</text><text class="num">¥{{adminHome.totalAllYuan}}</text></view>
      </view>

      <!-- 资金异常主动亮出来：失败/被关闭（不含主动撤回），点击直达失败台账 -->
      <view class="panel ah-alert" wx:if="{{adminHome && adminHome.failCount > 0}}" bindtap="goFailed" hover-class="is-press">
        <view class="ah-alert-main">
          <view class="ah-alert-t st st-fail">待处理异常 <text class="num">{{adminHome.failCount}}</text> 笔</view>
          <view class="ah-alert-s">转账失败或被关闭，点击查看失败台账</view>
        </view>
        <view class="chev" aria-hidden="true"></view>
      </view>

      <view class="rows ah-rows" wx:if="{{adminHome}}">
        <view class="row ah-row"><text class="ah-k">近24小时发放</text><text class="ah-v n2">{{adminHome.todayCount || 0}} 笔</text></view>
        <view class="row ah-row"><text class="ah-k">近24小时动账</text><text class="ah-v n2">¥{{adminHome.todayYuan || '0.00'}}</text></view>
      </view>

      <button class="btn btn-primary btn-block" hover-class="is-press" bindtap="goAdmin">进入工作台</button>
      <view class="ah-tips">定向发放 · 台账对账 · 客户等级榜</view>
      <!-- 没记过额度时没有深青块，累计发放落成一行注 -->
      <view class="ah-total" wx:if="{{adminHome && adminHome.totalAllYuan && !adminHome.hasQuota}}">累计发放 <text class="num">¥{{adminHome.totalAllYuan}}</text></view>
    </block>
    <block wx:else>
      <state-view icon="gift" title="暂时没有你的奖励" desc="{{emptyReason || '收到奖励后，打开这里即可领取'}}" />

      <!-- 奖励提醒：客户主动点才弹系统授权（后端未配置模板时不显示）。和到账后的入口同一套状态 -->
      <view class="sub panel" wx:if="{{subOn}}">
        <view class="sub-t" wx:if="{{subState==='on'}}">已开启提醒：有新奖励时，微信会通知你{{subAlways ? '。你选了总是允许，以后每次领取会自动续上' : ''}}</view>
        <view class="sub-t" wx:elif="{{subState==='off'}}">没有开启提醒。之后想开，点右上角「···」›「设置」›「通知管理」打开</view>
        <block wx:else>
          <view class="sub-t">{{subAlways ? '你选过总是允许：点下方按钮直接续上，不会再弹窗' : '有新奖励时，可以用微信服务通知提醒你（开一次，提醒一次）'}}</view>
          <button class="btn btn-secondary btn-block sub-btn" hover-class="is-press" bindtap="askSubscribe" loading="{{subState==='saving'}}" disabled="{{subState==='saving'}}">有新奖励时提醒我</button>
        </block>
      </view>

      <!-- 合作记录：降为一行注 -->
      <view class="coop" wx:if="{{profile && profile.count > 0}}">合作 {{profile.count}} 次 · 累计到账 ¥{{profile.totalYuan}} · LV{{profile.lv}} {{profile.name}}{{profile.count >= 2 && profile.nextText ? ' · ' + profile.nextText : ''}}</view>

      <!-- 员工开通入口：外部客户不需要看到内部开通流程，收成一行文字入口，
           编号与复制在工作台的"你还不是发放员"页里 -->
      <view class="textbtn staff-entry" hover-class="is-press" bindtap="goAdmin">我是员工，申请发放权限</view>
    </block>
  </block>

</view>
