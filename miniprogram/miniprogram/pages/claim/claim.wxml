<!-- 开屏放级联容器之外（fixed 浮层不进 .stagger-in）；只在冷启动亮（app.js onLaunch 置位）。
     ready 绑 entryReady：令牌流程等校验接口回来、直接打开等身份落定（含出错），开屏等它到了再淡出，
     不叠两个等待屏。不能绑 mode——链接进入时 mode 在发请求前就是 token 了 -->
<splash ready="{{entryReady}}" />
<view class="page stagger-in">

  <!-- 识别中：品牌山形弧带加载动效（四条弧带由下至上逐层点亮） -->
  <view class="state" wx:if="{{mode==='loading'}}">
    <view class="band-spinner state-icon" aria-label="加载中">
        <view class="band band-1"></view><view class="band band-2"></view><view class="band band-3"></view><view class="band band-4"></view>
      </view>
    <view class="state-t1">正在为你查看奖励</view>
    <view class="state-t2">通常只需要一两秒</view>
  </view>

  <!-- 连接失败 -->
  <view class="state" wx:if="{{mode==='error'}}">
    <view class="li li-alert state-icon"></view>
    <view class="state-t1">暂时连不上服务</view>
    <view class="state-t2">服务可能正在启动，点下方按钮再试一次</view>
    <view class="state-detail" wx:if="{{message}}">{{message}}</view>
    <button class="btn btn-fill state-btn" bindtap="retry">再试一次</button>
  </view>

  <!-- 奖励色块：领取前赭石块（白字）/ 到账后品牌面色（标志青底 + 墨字，v5.1 里程碑用法） -->
  <block wx:if="{{mode==='token' || mode==='mine'}}">
    <!-- 令牌已终结（过期/已领/已撤回）：直接给终态，不再出现可点的领取按钮 -->
    <view class="state" wx:if="{{tokenGone}}">
      <view class="li li-alert state-icon"></view>
      <view class="state-t1">无法领取</view>
      <view class="state-t2">{{tokenGone}}</view>
    </view>

    <!-- 可信收款单：发放方 → 金额与事由 → 当前状态 → 主按钮 → 官方确认说明 → 帮助。
         外部链接最怕"这是谁发的、为什么、钱到哪"，这三件事先讲清 -->
    <block wx:else>
      <!-- ① 发放方：品牌 + 发放员工 -->
      <view class="issuer">
        <text class="issuer-brand">梨响ROC</text>
        <text class="issuer-who">{{issuer ? issuer + ' 发给你' : '发给你的奖励'}}</text>
      </view>

      <!-- 领取前赭石块（白字）/ 到账后品牌面色（标志青底 + 墨字，v5.1 里程碑用法）。
           状态以查单为准：点了确认 ≠ 到账，只有 ok 才翻青面；dead 是失败/撤回终态，保持赭石不庆祝 -->
      <view class="reward-block {{status==='ok' ? 'field-brand' : 'block-red'}} block">
        <!-- 到账 = 结算通知/里程碑：角落落一枚轮印（v5.5 闲章，内容固定不计数；青面上墨色），一屏一枚 -->
        <view class="round-seal rb-seal" wx:if="{{status==='ok'}}" aria-hidden="true">
          <view class="mark"><view class="b b1"></view><view class="b b2"></view><view class="b b3"></view><view class="b b4"></view></view>
          <text class="n">扶摇</text><text class="r">ROC</text><text class="u">结构性复利</text>
        </view>
        <view class="rb-checkwrap" wx:if="{{status==='ok'}}"><view class="rb-check"></view></view>
        <!-- ② 当前状态：标题就是状态 -->
        <view class="rb-label">{{ status==='ok' ? (claimedCount > 1 ? '全部到账' : '已到账微信零钱') : status==='between' ? '本笔已到账' : (status==='confirming' || status==='arriving') ? '已确认收款 · 到账中' : status==='dead' ? deadTitle : resume ? '待确认收款' : '待领取' }}</view>
        <!-- 金额：链接金额没经后端核验（校验接口不可达）时不上屏任何数字 -->
        <view class="rb-amount" wx:if="{{mode==='token' && amtUnverified}}"><text class="rb-unverified">金额待核验</text></view>
        <view class="rb-amount" wx:else><text class="rb-sign num">¥</text><text class="rb-num num">{{ mode==='mine' ? mineAmt : amtText }}</text></view>
        <!-- 事由与去向：收款单的两行 -->
        <view class="rb-meta">
          <view class="rb-row" wx:if="{{mode==='mine' ? mineRemark : remark}}"><text class="rb-k">事由</text><text class="rb-v">{{ mode==='mine' ? mineRemark : remark }}</text></view>
          <view class="rb-row"><text class="rb-k">到账</text><text class="rb-v">微信零钱</text></view>
        </view>
        <!-- 大额拆单：一人多笔逐笔领，进度与已到账累计一直可见 -->
        <view class="rb-multi" wx:if="{{mode==='mine' && claimedCount + minePendCount > 1 && status!=='ok'}}">第 {{claimedCount + 1}}/{{claimedCount + minePendCount}} 笔{{claimedCount > 0 ? ' · 已到账 ¥' + claimedYuan : ''}}</view>

        <!-- ③ 进度：设计系统的「轮尺」三步——领取 → 微信确认 → 到账（颜色随块内文字） -->
        <view class="rb-steps" wx:if="{{status!=='dead' && !(mode==='token' && amtUnverified)}}" aria-hidden="true">
          <view class="round-ruler">
            <view class="r {{ (status==='idle' || status==='loading' || status==='fail') && !resume ? 'r-now' : 'r-done' }}"></view>
            <view class="r {{ (status==='idle' || status==='loading' || status==='fail') ? (resume ? 'r-now' : '') : 'r-done' }}"></view>
            <view class="r {{ (status==='ok' || status==='between') ? 'r-done' : (status==='confirming' || status==='arriving') ? 'r-now' : '' }}"></view>
          </view>
          <view class="rb-steps-t"><text>领取</text><text>微信确认</text><text>到账</text></view>
        </view>

        <!-- ④ 主按钮：只在领取前/可重试时出现。金额未核验给"重新连接"；入账查询超时给"刷新到账结果"；
             到账/失败终态不渲染按钮（青面上只许墨字/主色字，一颗禁用按钮既无动作也无合法配色） -->
        <button wx:if="{{mode==='token' && amtUnverified}}" class="rb-btn" bindtap="retryToken" loading="{{verifying}}" disabled="{{verifying}}">重新连接</button>
        <button
          wx:elif="{{status==='idle' || status==='loading' || status==='fail'}}"
          class="rb-btn"
          bindtap="{{ mode==='mine' ? 'onClaimMine' : 'onClaimToken' }}"
          loading="{{status==='loading'}}"
          disabled="{{status==='loading'}}"
        >{{resume ? '继续确认收款' : '领取到微信零钱'}}</button>
        <button wx:elif="{{status==='arriving'}}" class="rb-btn" bindtap="refreshArrival">刷新到账结果</button>
        <view class="rb-wait" wx:elif="{{status==='confirming' || status==='between'}}" aria-label="正在处理">
          <view class="band-spinner"><view class="band band-1"></view><view class="band band-2"></view><view class="band band-3"></view><view class="band band-4"></view></view>
        </view>

        <view class="rb-tip" wx:if="{{mode==='token' && amtUnverified}}">{{verifying ? '正在重新连接，核验金额…' : '暂时连不上服务，金额还没核验，点上方按钮再试'}}</view>
        <view class="rb-tip" wx:elif="{{message}}">{{message}}</view>
        <!-- ⑤ 官方确认说明：只在领取前有用；确认之后还挂着就成了过时提示 -->
        <view class="rb-fine" wx:if="{{!amtUnverified && (status==='idle' || status==='loading' || status==='fail')}}">点领取后弹出微信官方「确认收款」，确认后转入微信零钱</view>
      </view>

      <!-- ⑥ 帮助：按状态给一句下一步 -->
      <view class="help">{{ status==='ok' ? '可在微信「我 › 服务 › 钱包 › 零钱」查看这笔入账' : (status==='confirming' || status==='arriving' || status==='between') ? '微信入账通常几秒到几分钟，可稍后重新打开本页查看' : '对这笔奖励有疑问，请联系' + (issuer || '给你发奖励的员工') }}</view>

      <!-- 合作记录：降为一行次要信息；首次领取不提升级进度 -->
      <view class="coop" wx:if="{{profile && profile.count > 0}}">合作 {{profile.count}} 次 · 累计到账 ¥{{profile.totalYuan}} · LV{{profile.lv}} {{profile.name}}{{profile.count >= 2 && profile.nextText ? ' · ' + profile.nextText : ''}}</view>

      <!-- 管理员自己领奖励或打开链接时也要能回工作台（原先只有"无奖励"的首页才有入口） -->
      <button class="btn btn-fill btn-block admin-entry" wx:if="{{isAdmin}}" bindtap="goAdmin">进入工作台</button>
    </block>

    <!-- 下半版面：品牌大字报（到账后用赭石呼应奖励色） -->
    <view class="wm-zone">
      <view class="wm {{status==='ok' ? 'wm-red' : ''}} num">ROC</view>
      <view class="wm-line">梨响ROC · 奖励，说到做到</view>
    </view>
  </block>

  <!-- 无奖励 -->
  <block wx:if="{{mode==='empty'}}">
    <!-- 操作端主页：进门即仪表盘（额度剩余 + 近24h发放），不再是一句空话 -->
    <block wx:if="{{isAdmin}}">
      <view class="ahome-lede">
        <view class="lede">你好，<text class="em">{{roleLabel || '管理员'}}</text>。今天把奖励<text class="em">发给对的人</text>。</view>
      </view>

      <view class="block block-blue ah-hero" wx:if="{{adminHome && adminHome.hasQuota}}">
        <view class="ah-label">可发额度 · 剩余</view>
        <view class="ah-num num">{{adminHome.neg ? '-' : ''}}¥{{adminHome.remainingYuan}}</view>
        <view class="ah-sub" wx:if="{{adminHome.low}}">额度已用尽，进工作台充值</view>
      </view>

      <!-- 资金异常主动亮出来：失败/被关闭（不含主动撤回），点击直达失败台账 -->
      <view class="block ah-alert" wx:if="{{adminHome && adminHome.failCount > 0}}" bindtap="goFailed">
        <view class="ah-alert-t">待处理异常 <text class="num">{{adminHome.failCount}}</text> 笔</view>
        <view class="ah-alert-s">转账失败或被关闭，点击查看失败台账</view>
      </view>

      <view class="ah-minis" wx:if="{{adminHome}}">
        <view class="block tint-sky ah-mini">
          <view class="ahm-label">近24小时发放</view>
          <view class="ahm-num num t-dark">{{adminHome.todayCount || 0}} 笔</view>
        </view>
        <view class="block tint-blush ah-mini">
          <view class="ahm-label">近24小时动账</view>
          <view class="ahm-num num t-dark">¥{{adminHome.todayYuan || '0.00'}}</view>
        </view>
      </view>

      <button class="btn btn-blue btn-block" bindtap="goAdmin">进入工作台</button>
      <view class="ah-tips t-hint">定向发放 · 台账对账 · 客户等级榜</view>

      <!-- 下半版面：累计发放大字报（有内容的填充） -->
      <view class="wm-zone" wx:if="{{adminHome && adminHome.totalAllYuan}}">
        <view class="wm-label">累计发放</view>
        <view class="wm wm-num num">¥{{adminHome.totalAllYuan}}</view>
        <view class="wm-line">梨响ROC · 奖励，说到做到</view>
      </view>
    </block>
    <block wx:else>
      <view class="state">
        <view class="li li-gift state-icon"></view>
        <view class="state-t1">暂时没有你的奖励</view>
        <view class="state-t2">{{emptyReason || '收到奖励后，打开这里即可领取'}}</view>
        <!-- 订阅"奖励提醒"：一次允许=之后有新奖励直达微信服务通知一条（后端未配置时不显示） -->
        <button class="btn btn-fill state-btn" wx:if="{{subOn}}" bindtap="askSubscribe">有新奖励时提醒我</button>
      </view>

      <!-- 合作记录：降为一行次要信息 -->
      <view class="coop" wx:if="{{profile && profile.count > 0}}">合作 {{profile.count}} 次 · 累计到账 ¥{{profile.totalYuan}} · LV{{profile.lv}} {{profile.name}}{{profile.count >= 2 && profile.nextText ? ' · ' + profile.nextText : ''}}</view>

      <!-- 员工开通入口：外部客户不需要看到内部开通流程，收成一行文字入口，
           编号与复制在工作台的"你还不是发放员"页里 -->
      <view class="staff-entry" bindtap="goAdmin">我是员工，申请发放权限</view>

      <!-- 下半版面：品牌大字报（编辑部式填充） -->
      <view class="wm-zone">
        <view class="wm num">ROC</view>
        <view class="wm-line">梨响ROC · 奖励，说到做到</view>
      </view>
    </block>
  </block>

</view>
