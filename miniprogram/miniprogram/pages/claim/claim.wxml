<!-- 开屏放级联容器之外（fixed 浮层不进 .stagger-in）；只在冷启动亮（app.js onLaunch 置位）。
     ready 绑页面加载态：识别完（含出错）才算到，开屏等它到了再淡出，不叠两个等待屏 -->
<splash ready="{{mode !== 'loading'}}" />
<view class="page stagger-in">

  <!-- 识别中：品牌山形弧带加载动效（四条弧带由下至上逐层点亮） -->
  <view class="state" wx:if="{{mode==='loading'}}">
    <view class="band-spinner state-icon" aria-label="加载中">
        <view class="band band-1"></view><view class="band band-2"></view><view class="band band-3"></view><view class="band band-4"></view>
      </view>
    <view class="state-t1">正在为你查看奖励</view>
    <view class="state-t2">通常只需要一两秒</view>
  </view>

  <!-- 连接失败 -->
  <view class="state" wx:if="{{mode==='error'}}">
    <view class="li li-alert state-icon"></view>
    <view class="state-t1">暂时连不上服务</view>
    <view class="state-t2">服务可能正在启动，点下方按钮再试一次</view>
    <view class="state-detail" wx:if="{{message}}">{{message}}</view>
    <button class="btn btn-fill state-btn" bindtap="retry">再试一次</button>
  </view>

  <!-- 奖励色块：领取前赭石块（白字）/ 到账后品牌面色（标志青底 + 墨字，v5.1 里程碑用法） -->
  <block wx:if="{{mode==='token' || mode==='mine'}}">
    <!-- 令牌已终结（过期/已领/已撤回）：直接给终态，不再出现可点的领取按钮 -->
    <view class="state" wx:if="{{tokenGone}}">
      <view class="li li-alert state-icon"></view>
      <view class="state-t1">无法领取</view>
      <view class="state-t2">{{tokenGone}}</view>
    </view>

    <view wx:else class="reward-block {{status==='ok' ? 'field-brand' : 'block-red'}} {{celebrate ? 'celebrate' : ''}} block">
      <!-- 到账 = 结算通知/里程碑：角落落一枚轮印（v5.5 闲章，内容固定不计数；青面上墨色），一屏一枚 -->
      <view class="round-seal rb-seal" wx:if="{{status==='ok'}}" aria-hidden="true">
        <view class="mark"><view class="b b1"></view><view class="b b2"></view><view class="b b3"></view><view class="b b4"></view></view>
        <text class="n">扶摇</text><text class="r">ROC</text><text class="u">结构性复利</text>
      </view>
      <view class="rb-checkwrap" wx:if="{{status==='ok'}}"><view class="rb-check"></view></view>
      <view class="rb-label">{{ status==='ok' ? '已到账微信零钱' : (mode==='mine' ? '属于你的奖励' : '你收到一笔奖励') }}</view>
      <view class="rb-amount"><text class="rb-sign num">¥</text><text class="rb-num num">{{ mode==='mine' ? mineAmt : amtText }}</text></view>
      <view class="rb-remark" wx:if="{{mode==='mine' ? mineRemark : remark}}">{{ mode==='mine' ? mineRemark : remark }}</view>
      <!-- 大额拆单：一人多笔串行领，先让客户看到全貌 -->
      <view class="rb-multi" wx:if="{{mode==='mine' && minePendCount > 1 && status!=='ok'}}">共 {{minePendCount}} 笔 · 合计 ¥{{minePendYuan}}，领完本笔自动出下一笔</view>

      <!-- 到账后不再渲染按钮：终态由「已到账微信零钱」标题 + 墨色勾表达；
           青面上只许墨字/主色字，一颗禁用按钮在这里既无动作也无合法配色 -->
      <button
        wx:if="{{status!=='ok'}}"
        class="rb-btn"
        bindtap="{{ mode==='mine' ? 'onClaimMine' : 'onClaimToken' }}"
        loading="{{status==='loading'}}"
        disabled="{{status==='loading'}}"
      >领取到微信零钱</button>

      <view class="rb-tip" wx:if="{{message}}">{{message}}</view>
      <view class="rb-fine">点领取后弹出微信官方「确认收款」，确认即到账</view>
    </view>

    <view class="after-note" wx:if="{{mode==='mine' && claimedCount > 0 && status!=='ok'}}">
      本次已领取 {{claimedCount}} 笔，上面是新的一笔{{minePendCount > 1 ? '（还剩 ' + minePendCount + ' 笔）' : ''}}
    </view>

    <!-- 合作档案 · 等级（领取界面也能看到） -->
    <view class="panel lvcard" wx:if="{{profile}}">
      <view class="lv-line1">
        <text class="badge badge-blue">LV{{profile.lv}} · {{profile.name}}</text>
        <text class="lv-nums t-light num">合作 {{profile.count}} 次 · 累计 ¥{{profile.totalYuan}}</text>
      </view>
      <view class="lv-next t-hint" wx:if="{{profile.nextText}}">{{profile.nextText}}</view>
    </view>

    <!-- 下半版面：品牌大字报（到账后用赭石呼应奖励色） -->
    <view class="wm-zone">
      <view class="wm {{status==='ok' ? 'wm-red' : ''}} num">ROC</view>
      <view class="wm-line">梨响 ROC · 奖励，说到做到</view>
    </view>
  </block>

  <!-- 无奖励 -->
  <block wx:if="{{mode==='empty'}}">
    <!-- 操作端主页：进门即仪表盘（额度剩余 + 近24h发放），不再是一句空话 -->
    <block wx:if="{{isAdmin}}">
      <view class="ahome-lede">
        <view class="lede">你好，<text class="em">{{roleLabel || '管理员'}}</text>。今天把奖励<text class="em">发给对的人</text>。</view>
      </view>

      <view class="block block-blue ah-hero" wx:if="{{adminHome && adminHome.hasQuota}}">
        <view class="ah-label">可发额度 · 剩余</view>
        <view class="ah-num num {{adminHome.low ? 'ah-low' : ''}}">¥{{adminHome.remainingYuan}}</view>
        <view class="ah-sub" wx:if="{{adminHome.low}}">额度已用尽，进工作台充值</view>
      </view>

      <!-- 资金异常主动亮出来：失败/被关闭（不含主动撤回），点击直达失败台账 -->
      <view class="block ah-alert" wx:if="{{adminHome && adminHome.failCount > 0}}" bindtap="goFailed">
        <view class="ah-alert-t">待处理异常 <text class="num">{{adminHome.failCount}}</text> 笔</view>
        <view class="ah-alert-s">转账失败或被关闭，点击查看失败台账</view>
      </view>

      <view class="ah-minis" wx:if="{{adminHome}}">
        <view class="block tint-sky ah-mini">
          <view class="ahm-label">近24小时发放</view>
          <view class="ahm-num num t-dark">{{adminHome.todayCount || 0}} 笔</view>
        </view>
        <view class="block tint-blush ah-mini">
          <view class="ahm-label">近24小时动账</view>
          <view class="ahm-num num t-dark">¥{{adminHome.todayYuan || '0.00'}}</view>
        </view>
      </view>

      <button class="btn btn-blue btn-block" bindtap="goAdmin">进入工作台</button>
      <view class="ah-tips t-hint">定向发放 · 台账对账 · 客户等级榜</view>

      <!-- 下半版面：累计发放大字报（有内容的填充） -->
      <view class="wm-zone" wx:if="{{adminHome && adminHome.totalAllYuan}}">
        <view class="wm-label">累计发放</view>
        <view class="wm wm-num num">¥{{adminHome.totalAllYuan}}</view>
        <view class="wm-line">梨响 ROC · 奖励，说到做到</view>
      </view>
    </block>
    <block wx:else>
      <view class="state">
        <view class="li li-gift state-icon"></view>
        <view class="state-t1">暂时没有你的奖励</view>
        <view class="state-t2">{{emptyReason || '收到奖励后，打开这里即可领取'}}</view>
        <!-- 订阅"奖励提醒"：一次允许=之后有新奖励直达微信服务通知一条（后端未配置时不显示） -->
        <button class="btn btn-fill state-btn" wx:if="{{subOn}}" bindtap="askSubscribe">有新奖励时提醒我</button>
      </view>

      <!-- 合作档案 · 等级（没有奖励时开屏也能看到自己的记录池） -->
      <view class="panel lvcard" wx:if="{{profile}}">
        <view class="lv-line1">
          <text class="badge badge-blue">LV{{profile.lv}} · {{profile.name}}</text>
          <text class="lv-nums t-light num">合作 {{profile.count}} 次 · 累计 ¥{{profile.totalYuan}}</text>
        </view>
        <view class="lv-next t-hint" wx:if="{{profile.nextText}}">{{profile.nextText}}</view>
      </view>

      <view class="panel join">
        <view class="join-t t-dark">是本公司员工？</view>
        <view class="join-s t-light">把下面的编号发给管理员，开通发放权限</view>
        <view class="openid-row">
          <text class="openid-text num">{{ openid || '请在微信小程序内打开' }}</text>
          <text class="openid-copy" wx:if="{{openid}}" bindtap="copyOpenid">复制</text>
        </view>
      </view>

      <!-- 下半版面：品牌大字报（编辑部式填充） -->
      <view class="wm-zone">
        <view class="wm num">ROC</view>
        <view class="wm-line">梨响 ROC · 奖励，说到做到</view>
      </view>
    </block>
  </block>

</view>
