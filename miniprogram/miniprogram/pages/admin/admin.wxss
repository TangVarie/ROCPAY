/* ===== 工作台 · BYWOOD（色板 v5.1，token 见 app.wxss）=====
   间距一律取阶梯 8/16/24/32/40/48/64/96 rpx（DESIGN.md §4：梯外间距 = bug）；
   控件高度另有一套：40（徽标）/ 64（筛选 chip）/ 80（常规按钮）/ 88（触控行）/ 96（主按钮与输入） */

/* 导语头 */
.head { padding: 16rpx 8rpx 24rpx; }
.head-sub { margin-top: 16rpx; }

/* Tab：扁平 + 主色下划指示（深色模式主色自动翻亮青） */
.tabs { display: flex; gap: 8rpx; margin-bottom: 24rpx; }
.tab {
  position: relative;
  padding: 24rpx;
  font-size: 30rpx;
  color: var(--color-text-light);
  transition: color 120ms ease-out;
}
.tab.on { color: var(--color-text-dark); font-weight: 600; }
/* 资金异常红点：存在 FAIL/CLOSED（不含主动撤回）时挂在"记录"上，异常不能靠运营想起来去看。
   状态语义用 danger，不借品牌色（语义色只表状态；圆点是直角制度的合法例外）*/
.tab-dot {
  position: absolute;
  top: 16rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%; /* ok: 状态圆点本体即圆形 */
  background: var(--color-danger);
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 24rpx; right: 24rpx; bottom: 0;
  height: 6rpx;
  background: var(--color-primary);
}

/* 方式 chips：选中主色底，文字随 --color-on-primary（亮色白 / 深色墨） */
.chips { display: flex; gap: 16rpx; }
.chips-inline { flex: 1; }
.chip {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 32rpx;
  border-radius: var(--r-control);
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-fill);
  color: var(--color-text);
  transition: background-color 120ms ease-out, color 120ms ease-out;
}
.chip:active { opacity: 0.8; }
.chip.on { background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
.chips-note { font-size: 26rpx; margin: 16rpx 8rpx 24rpx; }

/* 白底描边块内部版式 */
.panel + .panel { margin-top: 24rpx; }
.prow { display: flex; align-items: center; justify-content: space-between; }
/* 区块层级交给字重与文字色阶（v5 起无前标） */
.ptitle { font-size: 34rpx; font-weight: 600; }
.psub { font-size: 26rpx; margin-top: 8rpx; line-height: 1.6; }
.psub.center { text-align: center; margin-top: 16rpx; }

/* 文字按钮（触控热区 ≥44px 由 padding 保证） */
.textbtn {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  padding: 16rpx;
}
.textbtn:active { opacity: 0.6; }
.prow .textbtn { padding-right: 0; } /* 面板标题行的文字按钮与右缘对齐 */
.textbtn-plain { color: var(--color-text-light); }
.textbtn-danger { color: var(--color-danger); }
.center-self { text-align: center; margin-top: 8rpx; }

/* 搜索 */
.searchbar { display: flex; gap: 16rpx; margin: 24rpx 0 8rpx; }
.searchinput { flex: 1; }
.searchbtn {
  flex: none;
  height: 96rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  margin: 0;
}
.ph { color: var(--color-text-faint); }

/* 客户行：发丝线分隔 */
.cust {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 8rpx;
}
.cust:active { background: var(--color-fill); }
.cust:last-of-type::after { display: none; }
.cust-main { flex: 1; min-width: 0; }
.cust-name { font-size: 30rpx; font-weight: 500; }
.cust-sub { font-size: 24rpx; margin-top: 8rpx; }

/* 勾选框：直角方形，选中主色底（画勾是圆头笔画，直角制度的合法例外）；
   勾的颜色随 --color-on-primary——深色模式亮青底上白勾只有 2.11:1 */
.cb {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border: 3rpx solid rgba(0, 0, 0, 0.2);
  border-radius: var(--r-check);
  box-sizing: border-box;
  position: relative;
  transition: background-color 120ms ease-out, border-color 120ms ease-out;
}
.cb.on { background: var(--color-primary); border-color: var(--color-primary); }
.cb.on::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 18rpx; height: 9rpx;
  border-left: 4rpx solid var(--color-on-primary);
  border-bottom: 4rpx solid var(--color-on-primary);
  /* transform 居中代替硬坐标：rpx 取整在不同机型上不会再偏心 */
  transform: translate(-50%, -65%) rotate(-45deg);
}

/* 面板内空态 */
.pempty { padding: 48rpx 24rpx 32rpx; display: flex; flex-direction: column; align-items: center; }
.pempty-icon { width: 80rpx; height: 80rpx; margin-bottom: 24rpx; }
.pempty-t1 { font-size: 30rpx; font-weight: 600; }
.pempty-t2 { font-size: 26rpx; margin-top: 8rpx; text-align: center; }
.pempty-btn { margin-top: 32rpx; min-width: 300rpx; width: auto; height: auto; min-height: 80rpx; padding: 8rpx 32rpx; box-sizing: border-box; font-size: 28rpx; }
/* 面板内骨架行：与客户行同高，≥3 行 */
.pskel { padding: 8rpx 0; }

/* 已选条 */
.pickbar {
  margin-top: 16rpx;
  padding-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pickbar-r { display: flex; align-items: center; gap: 8rpx; }
.pickbtn { height: 80rpx; padding: 0 32rpx; font-size: 28rpx; margin: 0; }

/* 统一填充：行内文字按钮与 96rpx 输入框等高，避免跨组件 center 对不齐 */
.fillall { display: flex; align-items: center; gap: 16rpx; margin: 24rpx 0 8rpx; }
.fa-amt { width: 180rpx; flex: none; text-align: center; }
.fa-note { flex: 1; }
.fillall .textbtn { height: 96rpx; line-height: 96rpx; padding-top: 0; padding-bottom: 0; }

/* 逐人行 */
.frow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}
.frow-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.frow-amt { width: 150rpx; flex: none; height: 88rpx; line-height: 88rpx; padding: 0 16rpx; text-align: center; font-size: 30rpx; }
.frow-note { width: 190rpx; flex: none; height: 88rpx; line-height: 88rpx; padding: 0 16rpx; font-size: 28rpx; }
/* 可交互元素不许用 faint（白底 ~2.1:1，低于 WCAG 组件 3:1 底线），用 light 档 */
.frow-del { flex: none; font-size: 24rpx; color: var(--color-text-light); padding: 16rpx 8rpx; }
.frow-del:active { color: var(--color-danger); }
/* 校验失败的行：语义浅底高亮 + 金额框加深，配合 pageScrollTo 定位，30 人时不用自己翻着找 */
.frow-err { background: var(--color-danger-tint); }
.frow-err .frow-amt { border-color: var(--color-danger); }
.submitbtn { margin-top: 32rpx; }

/* 语义横幅：语义色/10 底 + 黑字（彩字上浅底对比不够，禁止） */
.banner {
  border-radius: var(--r-block);
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.banner-success { background: var(--color-success-tint); }
.banner-danger { background: var(--color-danger-tint); }
.banner-line { font-size: 26rpx; margin-top: 8rpx; }
.reward-ok { margin: 24rpx 0 24rpx; }

/* 群发文案（textarea 多行：解除单行 input 的固定高度） */
.notify-ta {
  width: 100%;
  height: auto;
  min-height: 120rpx;
  line-height: 1.6;
  padding: 24rpx;
  margin: 24rpx 0;
}

/* 表单
   原生 input 与 view 文字是两套排版度量，align-items:center 混排必然微错位。
   解法：标签做成与输入框等高(96rpx)的行盒，行内基线自然对齐 */
.field { display: flex; align-items: center; margin: 24rpx 0; }
.flabel {
  width: 140rpx;
  flex: none;
  font-size: 28rpx;
  color: var(--color-text-light);
  height: 96rpx;
  line-height: 96rpx;
}
.finput { flex: 1; }

/* ---- 记录 · 数据色块（一对浅调：主浅调主块 + 主/强调浅调迷你块，不三块同色同规格排排坐）---- */
.statrow { display: flex; gap: 24rpx; margin-bottom: 32rpx; }
.stat-main {
  flex: 1.35;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
/* 批次视图操作行：整批撤回入口，紧贴汇总块右缘 */
.batch-actions { display: flex; justify-content: flex-end; margin: -16rpx 0 24rpx; }
/* 失败筛选下的"标记已处理"操作行 */
.alert-actions { display: flex; justify-content: flex-end; margin: -8rpx 0 16rpx; }
.sm-label { font-size: 26rpx; color: var(--color-text-light); }
.sm-num { font-size: 80rpx; font-weight: 700; color: var(--color-text-dark); line-height: 1.15; margin-top: 8rpx; }
.sm-sub { font-size: 24rpx; color: var(--color-text-light); margin-top: 8rpx; }
.stat-side { flex: 1; display: flex; flex-direction: column; gap: 24rpx; }
.stat-mini { padding: 24rpx; }
.smm-label { font-size: 24rpx; color: var(--color-text-light); }
.smm-num { font-size: 42rpx; font-weight: 700; line-height: 1.2; margin-top: 8rpx; }

/* ---- 记录 · 实时可用余额主块（深青块，白字，两模式恒定）---- */
.bal { margin-bottom: 24rpx; }
.bal-top { display: flex; align-items: center; justify-content: space-between; }
.bal-label { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); }
.bal-refresh { font-size: 26rpx; color: rgba(255, 255, 255, 0.9); padding: 8rpx 8rpx 8rpx 24rpx; }
.bal-refresh:active { opacity: 0.6; }
.bal-actions { display: flex; align-items: center; }
.bal-actions .bal-refresh { padding: 8rpx 0 8rpx 32rpx; } /* 充值/校准两个动作并排 */
.bal-num { font-size: 80rpx; font-weight: 700; color: #ffffff; line-height: 1.15; margin-top: 8rpx; }
.bal-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); margin-top: 8rpx; }
/* 剩余告罄/超支：深色块内禁第三种彩色文字（DESIGN.md #13），告警由 bal-sub 的文案承担，
   数字只加重不变色（色彩永不作为唯一信息通道） */
.bal-low { font-weight: 800; }

/* 充值/校准输入面板（自绘，替代桌面端不支持的 showModal editable） */
.quota-panel { margin-bottom: 24rpx; }
.quota-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.quota-input { flex: 1; }
.quota-btn { flex: none; height: 96rpx; padding: 0 32rpx; font-size: 28rpx; margin: 0; }

/* 台账搜索条：与筛选 chips 同区，下边距收紧 */
.rec-search { margin: 0 0 16rpx; }

/* 台账筛选 chips：比方式 chips 小一号但高度 ≥64rpx（32px 触控目标，筛选高频不许误触） */
.fchips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.fchip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--r-control);
  font-size: 26rpx;
  background: var(--color-fill);
  color: var(--color-text);
}
.fchip.on { background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
.fchip:active { opacity: 0.8; }
/* 单人/批次/关键词筛选中（点一下清除）：赭石块 + 白字。走 block-accent 而不是 accent——
   深色模式 accent 是亮赭，白字只有 2.97:1；block-accent 的深赭 5.92:1 */
.fchip-target { background: var(--color-block-accent); color: #ffffff; }

/* 记录行撤回 + 批次入口 + 加载更多。撤回是危险操作：热区拉到 ≥64rpx 高，误触成本高于视觉紧凑 */
.rec-revoke { font-size: 26rpx; font-weight: 600; color: var(--color-danger); padding: 16rpx 8rpx; margin: -8rpx -8rpx; }
.rec-revoke:active { opacity: 0.6; }
.rec-batch { font-size: 24rpx; font-weight: 500; color: var(--color-primary); padding: 16rpx 8rpx; margin: -8rpx -8rpx; }
.rec-batch:active { opacity: 0.6; }
.loadmore { text-align: center; padding: 32rpx 0 8rpx; }
.loadmore-hint { text-align: center; padding: 16rpx 24rpx 8rpx; font-size: 26rpx; line-height: 1.5; }

/* 记录行：画布直排 + 发丝线 */
.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 8rpx;
}
.rec-l { flex: 1; min-width: 0; }
.rec-line1 { display: flex; align-items: baseline; gap: 16rpx; }
.rec-amt { font-size: 34rpx; font-weight: 600; }
/* 客户名 = 单人往来入口：主色示意可点，点击后台账只看这个人 */
.rec-who { font-size: 26rpx; color: var(--color-primary); font-weight: 500; }
.rec-who:active { opacity: 0.6; }
.rec-remark { font-size: 24rpx; margin-top: 8rpx; }
.rec-r { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.rec-time { font-size: 24rpx; }

/* 员工行 */
.staff {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 8rpx;
}
.staff:last-of-type::after { display: none; }
.staff-l { flex: 1; min-width: 0; }
.staff-name { font-size: 30rpx; font-weight: 500; display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.staff-oid { font-size: 24rpx; word-break: break-all; margin-top: 8rpx; }
/* 员工行操作列：编辑 / 停用|启用 / 移除 */
.staff-actions { flex: none; display: flex; align-items: center; }
.staff-act { font-size: 26rpx; padding: 16rpx 8rpx; }

/* 状态页（空/提示） */
.state {
  padding: 96rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-icon { margin-bottom: 32rpx; }
.state-t1 { font-size: 34rpx; font-weight: 600; color: var(--color-text-dark); }
.state-t2 { margin-top: 8rpx; font-size: 26rpx; color: var(--color-text-light); text-align: center; }
/* 宽度改下限、高度可撑：系统字体放大时文字变宽变高，固定宽高会折行裁字 */
.state-btn { margin-top: 40rpx; min-width: 320rpx; width: auto; height: auto; min-height: 96rpx; padding: 16rpx 40rpx; box-sizing: border-box; }
/* 列表加载态：骨架行 ×3（scenarios/04「骨架屏优先」），不再用满屏转圈把列表位置顶空 */
.list-skel { padding: 8rpx 0; }

/* ---- 客户等级总榜 ---- */
.rank-head { margin-bottom: 16rpx; }
/* 等级分布筛选条 */
.lvchips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.lvchip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: var(--r-control);
  font-size: 26rpx;
  background: var(--color-fill);
  color: var(--color-text);
}
.lvchip.on { background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
.lvchip:active { opacity: 0.8; }
.lvchip-n { margin-left: 8rpx; opacity: 0.75; }
.rk { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 8rpx; }
.rk:active { background: var(--color-fill); }
.rk-no { width: 56rpx; flex: none; font-size: 34rpx; font-weight: 700; color: var(--color-text-hint); text-align: center; }
.rk-top { color: var(--color-primary); } /* 前三名主色 */
.rk-main { flex: 1; min-width: 0; }
.rk-name { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; font-size: 30rpx; font-weight: 500; }
.rk-sub { font-size: 24rpx; margin-top: 8rpx; }
.rk-amt { flex: none; font-size: 30rpx; font-weight: 600; }

/* openid（与领取页一致） */
.openid-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-fill);
  border-radius: var(--r-control);
  padding: 24rpx;
}
.openid-text { flex: 1; word-break: break-all; font-size: 24rpx; color: var(--color-text-light); }
.openid-copy { flex: none; font-size: 26rpx; font-weight: 600; color: var(--color-primary); padding: 8rpx 16rpx; }

/* ===== 统一选人名单（企微客户 + 直连客户一人一行） ===== */
.pactions { display: flex; gap: 32rpx; }
.dadd { padding: 8rpx 0; }
.dadd-input { width: 100%; box-sizing: border-box; margin-bottom: 16rpx; }
.dadd-btn { margin-bottom: 16rpx; }
/* 直连行副行是 openid 长串（无空格）：强制可断行，不撑破行布局；企微行副行为名字，不受影响 */
.cust-sub { word-break: break-all; }
