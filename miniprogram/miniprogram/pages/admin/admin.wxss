/* ===== 工作台 · BYWOOD ===== */

/* 导语头 */
.head { padding: 16rpx 4rpx 24rpx; }
.head-sub { margin-top: 12rpx; }

/* Tab：扁平 + 蓝色下划指示 */
.tabs { display: flex; gap: 8rpx; margin-bottom: 24rpx; }
.tab {
  position: relative;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: var(--text-light);
  transition: color 120ms ease-out;
}
.tab.on { color: var(--text-dark); font-weight: 600; }
.tab.on::after {
  content: '';
  position: absolute;
  left: 24rpx; right: 24rpx; bottom: 0;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* 方式 chips：选中品牌蓝 */
.chips { display: flex; gap: 16rpx; }
.chips-inline { flex: 1; }
.chip {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  border-radius: var(--r-control);
  font-size: 27rpx;
  font-weight: 500;
  background: var(--fill);
  color: var(--text);
  transition: background-color 120ms ease-out, color 120ms ease-out;
}
.chip:active { opacity: 0.8; }
.chip.on { background: var(--primary); color: #ffffff; font-weight: 600; }
.chips-note { font-size: 24rpx; margin: 12rpx 4rpx 24rpx; }

/* 白底描边块内部版式 */
.panel + .panel { margin-top: 24rpx; }
.prow { display: flex; align-items: center; justify-content: space-between; }
.ptitle { font-size: 32rpx; font-weight: 600; }
.psub { font-size: 24rpx; margin-top: 8rpx; line-height: 1.6; }
.psub.center { text-align: center; margin-top: 16rpx; }

/* 文字按钮（触控热区 ≥44px 由 padding 保证） */
.textbtn {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 16rpx 12rpx;
}
.textbtn:active { opacity: 0.6; }
.prow .textbtn { padding-right: 0; } /* 面板标题行的文字按钮与右缘对齐 */
.textbtn-plain { color: var(--text-light); }
.textbtn-danger { color: var(--danger); }
.center-self { text-align: center; margin-top: 8rpx; }

/* 搜索 */
.searchbar { display: flex; gap: 16rpx; margin: 20rpx 0 8rpx; }
.searchinput { flex: 1; }
.searchbtn {
  flex: none;
  height: 84rpx;

  padding: 0 36rpx;
  font-size: 27rpx;
  margin: 0;
}
.ph { color: var(--text-faint); }

/* 客户行：发丝线分隔 */
.cust {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 4rpx;
}
.cust:active { background: rgba(0, 0, 0, 0.05); }
.cust:last-of-type::after { display: none; }
.cust-main { flex: 1; min-width: 0; }
.cust-name { font-size: 30rpx; font-weight: 500; }
.cust-sub { font-size: 22rpx; margin-top: 2rpx; }

/* 勾选框：方形 8px 圆角，选中品牌蓝 */
.cb {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  border: 3rpx solid rgba(0, 0, 0, 0.2);
  border-radius: var(--r-check);
  box-sizing: border-box;
  position: relative;
  transition: background-color 120ms ease-out, border-color 120ms ease-out;
}
.cb.on { background: var(--primary); border-color: var(--primary); }
.cb.on::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 18rpx; height: 9rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  /* transform 居中代替硬坐标：rpx 取整在不同机型上不会再偏心 */
  transform: translate(-50%, -65%) rotate(-45deg);
}

/* 面板内空态 */
.pempty { padding: 48rpx 24rpx 32rpx; display: flex; flex-direction: column; align-items: center; }
.pempty-icon { width: 80rpx; height: 80rpx; margin-bottom: 20rpx; }
.pempty-t1 { font-size: 30rpx; font-weight: 600; }
.pempty-t2 { font-size: 24rpx; margin-top: 6rpx; text-align: center; }
.pempty-btn { margin-top: 32rpx; width: 300rpx; height: 80rpx; font-size: 27rpx; }

/* 已选条 */
.pickbar {
  margin-top: 16rpx;
  padding-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pickbar-r { display: flex; align-items: center; gap: 8rpx; }
.pickbtn { height: 76rpx; padding: 0 36rpx; font-size: 27rpx; margin: 0; }

/* 统一填充：行内文字按钮与 84rpx 输入框等高，避免跨组件 center 对不齐 */
.fillall { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 0 8rpx; }
.fa-amt { width: 180rpx; flex: none; text-align: center; }
.fa-note { flex: 1; }
.fillall .textbtn { height: 84rpx; line-height: 84rpx; padding-top: 0; padding-bottom: 0; }

/* 逐人行 */
.frow {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 0;
}
.frow-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.frow-amt { width: 150rpx; flex: none; height: 76rpx; line-height: 76rpx; padding: 0 16rpx; text-align: center; font-size: 28rpx; }
.frow-note { width: 190rpx; flex: none; height: 76rpx; line-height: 76rpx; padding: 0 18rpx; font-size: 26rpx; }
.frow-del { flex: none; font-size: 24rpx; color: var(--text-faint); padding: 16rpx 8rpx; }
.frow-del:active { color: var(--danger); }
.submitbtn { margin-top: 28rpx; }

/* 语义横幅：语义色/10 底 + 黑字 */
.banner {
  border-radius: var(--r-block);
  padding: 26rpx 30rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.banner-success { background: rgba(0, 181, 120, 0.1); }
.banner-danger { background: rgba(184, 41, 60, 0.08); }
.banner-line { font-size: 24rpx; margin-top: 6rpx; }
.reward-ok { margin: 24rpx 0 20rpx; }

/* 群发文案（textarea 多行：解除单行 input 的固定高度） */
.notify-ta {
  width: 100%;
  height: auto;
  min-height: 120rpx;
  line-height: 1.6;
  padding: 22rpx 26rpx;
  margin: 20rpx 0 24rpx;
}

/* 表单
   原生 input 与 view 文字是两套排版度量，align-items:center 混排必然微错位。
   解法：标签做成与输入框等高(84rpx)的行盒，行内基线自然对齐 */
.field { display: flex; align-items: center; margin: 24rpx 0; }
.flabel {
  width: 140rpx;
  flex: none;
  font-size: 27rpx;
  color: var(--text-light);
  height: 84rpx;
  line-height: 84rpx;
}
.finput { flex: 1; }

/* ---- 记录 · 数据色块（蓝主块 + 浅调对） ---- */
.statrow { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.stat-main {
  flex: 1.35;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sm-label { font-size: 24rpx; color: rgba(0, 0, 0, 0.55); }
.sm-num { font-size: 72rpx; font-weight: 700; color: rgba(0, 0, 0, 0.9); line-height: 1.15; margin-top: 8rpx; }
.sm-sub { font-size: 22rpx; color: rgba(0, 0, 0, 0.55); margin-top: 6rpx; }
.stat-side { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.stat-mini { padding: 22rpx 26rpx; }
.smm-label { font-size: 22rpx; color: rgba(0, 0, 0, 0.6); }
.smm-num { font-size: 44rpx; font-weight: 700; line-height: 1.2; margin-top: 2rpx; }

/* ---- 记录 · 实时可用余额主块 ---- */
.bal { margin-bottom: 20rpx; }
.bal-top { display: flex; align-items: center; justify-content: space-between; }
.bal-label { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); }
.bal-refresh { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); padding: 8rpx 4rpx 8rpx 24rpx; }
.bal-refresh:active { opacity: 0.6; }
.bal-actions { display: flex; align-items: center; }
.bal-actions .bal-refresh { padding: 8rpx 0 8rpx 28rpx; } /* 充值/校准两个动作并排 */
.bal-num { font-size: 80rpx; font-weight: 700; color: #ffffff; line-height: 1.15; margin-top: 10rpx; }
.bal-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); margin-top: 8rpx; }
.bal-low { color: #ffb0b0; font-weight: 700; } /* 剩余告罄/超支：浅红提醒 */

/* 台账筛选 chips：比方式 chips 更小一号，可横向换行 */
.fchips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.fchip {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--r-control);
  font-size: 24rpx;
  background: var(--fill);
  color: var(--text);
}
.fchip.on { background: var(--primary); color: #ffffff; font-weight: 600; }
.fchip:active { opacity: 0.8; }
.fchip-target { background: var(--accent); } /* 单人筛选中：点一下清除 */

/* 记录行撤回 + 加载更多 */
.rec-revoke { font-size: 24rpx; font-weight: 600; color: var(--danger); padding: 8rpx 4rpx; }
.rec-revoke:active { opacity: 0.6; }
.loadmore { text-align: center; padding: 28rpx 0 8rpx; }

/* 记录行：画布直排 + 发丝线 */
.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 26rpx 4rpx;
}
.rec-l { flex: 1; min-width: 0; }
.rec-line1 { display: flex; align-items: baseline; gap: 14rpx; }
.rec-amt { font-size: 34rpx; font-weight: 600; }
/* 客户名 = 单人往来入口：主色示意可点，点击后台账只看这个人 */
.rec-who { font-size: 25rpx; color: var(--primary); font-weight: 500; }
.rec-who:active { opacity: 0.6; }
.rec-remark { font-size: 23rpx; margin-top: 2rpx; }
.rec-r { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.rec-time { font-size: 22rpx; }

/* 员工行 */
.staff {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 4rpx;
}
.staff:last-of-type::after { display: none; }
.staff-l { flex: 1; min-width: 0; }
.staff-name { font-size: 29rpx; font-weight: 500; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.staff-oid { font-size: 22rpx; word-break: break-all; margin-top: 4rpx; }

/* 状态页（空/提示） */
.state {
  padding: 88rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-icon { margin-bottom: 28rpx; }
.state-t1 { font-size: 34rpx; font-weight: 600; color: var(--text-dark); }
.state-t2 { margin-top: 8rpx; font-size: 26rpx; color: var(--text-light); text-align: center; }

/* ---- 客户等级总榜 ---- */
.rank-head { margin-bottom: 16rpx; }
/* 等级分布筛选条 */
.lvchips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.lvchip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: var(--r-control);
  font-size: 23rpx;
  background: var(--fill);
  color: var(--text);
}
.lvchip.on { background: var(--primary); color: #ffffff; font-weight: 600; }
.lvchip:active { opacity: 0.8; }
.lvchip-n { margin-left: 4rpx; opacity: 0.75; }
.rk { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 4rpx; }
.rk:active { background: rgba(0, 0, 0, 0.04); }
.rk-no { width: 56rpx; flex: none; font-size: 32rpx; font-weight: 700; color: var(--text-faint); text-align: center; }
.rk-top { color: var(--primary); } /* 前三名主色 */
.rk-main { flex: 1; min-width: 0; }
.rk-name { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; font-size: 29rpx; font-weight: 500; }
.rk-sub { font-size: 22rpx; margin-top: 2rpx; }
.rk-amt { flex: none; font-size: 30rpx; font-weight: 600; }

/* openid（与领取页一致） */
.openid-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--fill);
  border-radius: var(--r-control);
  padding: 22rpx 26rpx;
}
.openid-text { flex: 1; word-break: break-all; font-size: 24rpx; color: var(--text-light); }
.openid-copy { flex: none; font-size: 26rpx; font-weight: 600; color: var(--primary); padding: 10rpx 14rpx; }
