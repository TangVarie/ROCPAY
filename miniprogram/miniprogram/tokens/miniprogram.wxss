/**
 * BYWOOD 小程序 token v2（rpx 制，750 设计稿）
 * 规则同 DESIGN.md + scenarios/04-miniprogram.md；换算：1px（375 稿）= 2rpx。
 * WXSS 支持 CSS 变量；深色模式在 app.json 开 "darkmode": true 后用媒体查询翻转。
 * DIN 字体小程序不可内置——数字用系统栈 + 加粗 + tabular（.num 类）近似。
 */
page {
  --color-primary: #1e5754;
  --color-primary-dark: #16413f;
  --color-accent: #b8502f;
  --color-block-primary: #1e5754;
  --color-block-accent: #b8502f;
  --color-tint-primary: #e3efef;
  --color-tint-accent: #f8eae2;
  --color-field-brand: #7ed1cd; /* ok: 品牌面色（v5.1）：做底不做字，块内墨字 */
  --color-success: #00b578;
  --color-warning: #ff8f1f;
  --color-danger: #d92b3c;
  --color-bg: #f3f4f6;
  --color-bg-secondary: #eaecef;
  --color-surface: #ffffff;
  --color-fill: rgba(0, 0, 0, 0.045);
  --color-text-dark: rgba(0, 0, 0, 0.9);
  --color-text: rgba(0, 0, 0, 0.65);
  --color-text-light: rgba(0, 0, 0, 0.55);
  --color-text-faint: rgba(0, 0, 0, 0.3);
  --color-border: rgba(0, 0, 0, 0.08);
  --color-border-strong: #e5e6eb;

  background: var(--color-bg);
  color: var(--color-text);
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx; /* 正文 15px 档 */
}

@media (prefers-color-scheme: dark) {
  /* 深色模式：逐值取自 palette.json screen.dark（v5.4.1 修：此前误写为亮色值）；
   * 主色按钮压墨字不压白字（亮青上白字仅 2.11:1）；check-design.py 的 SYNC 自本版起比对本块 */
  page {
    --color-primary: #6ac1bd;
    --color-primary-dark: #48a8a3;
    --color-accent: #d97e55;
    --color-block-primary: #1e5754; /* 深色块底照旧主色深档，白字 */
    --color-block-accent: #a84528;
    --color-tint-primary: #163b39;
    --color-tint-accent: #3d291f;
    --color-field-brand: #7ed1cd; /* ok: 品牌面色两模式同值，块内墨字 */
    --color-success: #21b183;
    --color-warning: #ffa24d;
    --color-danger: #e8575c;
    --color-bg: #0f1318;
    --color-bg-secondary: #151a20;
    --color-surface: #1b222b;
    --color-fill: rgba(255,255,255,0.06);
    --color-text-dark: rgba(255,255,255,0.92);
    --color-text: rgba(255,255,255,0.70);
    --color-text-light: rgba(255,255,255,0.55);
    --color-text-faint: rgba(255,255,255,0.34);
    --color-border: rgba(255,255,255,0.10);
    --color-border-strong: #2b3440;
  }
}

/* ---- 文字阶梯（rpx = 2×px 档）---- */
.t-num-xl { font-size: 80rpx; font-weight: 600; }  /* 40 大数字 */
.t-title  { font-size: 56rpx; font-weight: 700; color: var(--color-text-dark); } /* 28 页面标题 */
.t-lead   { font-size: 42rpx; font-weight: 500; }  /* 21 编辑导语 */
.t-row    { font-size: 34rpx; font-weight: 600; color: var(--color-text-dark); } /* 17 行标题 */
.t-body   { font-size: 30rpx; }                     /* 15 正文 */
.t-note   { font-size: 26rpx; color: var(--color-text-light); } /* 13 说明 */
.t-meta   { font-size: 24rpx; color: var(--color-text-light); } /* 12 meta，最小档 */

/* 金额/积分：tabular 数字 + 加粗（DIN 不可用时的官方近似） */
.num { font-family: 'Helvetica Neue', sans-serif; font-variant-numeric: tabular-nums; font-weight: 600; }
.money { color: var(--color-accent); }

/* ---- 按钮（覆盖原生 button 样式）---- */
.btn { border-radius: 0; border: none; font-weight: 600; }
.btn::after { border: none; }
.btn-primary { background: var(--color-primary); color: #fff; height: 96rpx; line-height: 96rpx; font-size: 32rpx; }
.btn-primary.btn-hover { background: var(--color-primary-dark); transform: scale(0.98); }
.btn-secondary { background: var(--color-fill); color: var(--color-text-dark); height: 80rpx; line-height: 80rpx; font-size: 28rpx; }

/* ---- 色块 ---- */
.block { padding: 32rpx; }
.block-blue { background: var(--color-block-primary); color: #fff; }
.block-blue .label { color: rgba(255, 255, 255, 0.85); }
.block-red { background: var(--color-block-accent); color: #fff; }
.tint-sky { background: var(--color-tint-primary); }
.tint-blush { background: var(--color-tint-accent); }

/* ---- 发丝线（1rpx 物理像素）---- */
.hairline-b { position: relative; }
.hairline-b::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0;
  height: 1rpx; background: var(--color-border);
}
.hairline-b-inset::after { left: 32rpx; }

/* ---- 单元行：行高 ≥88rpx（44px 触控），按压变灰 ---- */
.cell { min-height: 88rpx; display: flex; align-items: center; padding: 0 32rpx; }
.cell-hover { background: var(--color-fill); }

/* ---- 徽标：语义浅底 + 加深档文字 ---- */
.badge { display: inline-block; height: 40rpx; line-height: 40rpx; padding: 0 12rpx; font-size: 24rpx; }
.badge-success { background: rgba(0, 181, 120, 0.1); color: #006b4a; }
.badge-warning { background: rgba(255, 143, 31, 0.1); color: #995400; }
.badge-danger  { background: rgba(217, 43, 60, 0.1); color: #b02330; }

/* ---- 「轮」的装置（2026-09-02 拍板；与 globals.css 的 round-seal / round-ruler 同规格）----
 * 轮尺（B，界面轨主用）：<view class="round-ruler"><view class="r r-done"/><view class="r r-now"/><view class="r"/></view>
 * 轮印（A，闲章：内容固定不计数）：<view class="round-seal"><view class="mark">…四条横条（同 band-spinner 近似）…</view><text class="n">扶摇</text><text class="r">ROC</text><text class="u">结构性复利</text></view>
 * 颜色随 color；轮尺默认主色，轮印默认墨色；青面上一律墨色。 */
.round-ruler { position: relative; display: flex; justify-content: space-between; align-items: center; height: 24rpx; color: var(--color-primary); }
.round-ruler::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1rpx; background: currentColor; opacity: 0.5; }
.round-ruler .r { position: relative; width: 16rpx; height: 16rpx; box-sizing: border-box; border: 3rpx solid currentColor; background: transparent; }
.round-ruler .r-done { background: currentColor; }
.round-ruler .r-now { width: 24rpx; height: 24rpx; background: currentColor; }
.round-ruler .r-now::after { content: ''; position: absolute; left: 5rpx; top: 5rpx; right: 5rpx; bottom: 5rpx; border: 2rpx solid var(--color-bg); }
.round-seal { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; width: 110rpx; height: 110rpx; box-sizing: border-box; border: 3rpx solid currentColor; color: var(--color-text-dark); line-height: 1; }
.round-seal .n { font-family: 'Songti SC', 'Noto Serif SC', serif; font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.round-seal .r { font-family: Georgia, serif; font-size: 14rpx; font-weight: 700; letter-spacing: 4rpx; margin-left: 4rpx; }
.round-seal .u { font-size: 13rpx; letter-spacing: 1rpx; }

/* ---- 安全区 ---- */
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }

/* 加载动画：山形四条弧带由下至上逐层点亮（小程序无 SVG，用四条等高横条近似）。
 * 用法：<view class="band-spinner"><view class="band band-1"/>…<view class="band band-4"/></view>
 * 宽度自上而下递增，复刻山形的层叠感；只用主色一色做明暗递进。 */
.band-spinner { display: inline-flex; flex-direction: column; align-items: center; gap: 6rpx; }
.band-spinner .band { height: 6rpx; background: var(--color-primary); animation: band-rise 1.2s infinite; }
.band-spinner .band-1 { width: 40rpx; animation-delay: 0.36s; }
.band-spinner .band-2 { width: 64rpx; animation-delay: 0.24s; }
.band-spinner .band-3 { width: 88rpx; animation-delay: 0.12s; }
.band-spinner .band-4 { width: 112rpx; animation-delay: 0s; }
@keyframes band-rise { 0%, 100% { opacity: 0.22; } 35% { opacity: 1; } }

/* ---- 骨架屏微光（UI 渐变禁令的唯一豁免）---- */
.skeleton-base {
  background: var(--color-bg-secondary);
  animation: skeleton-pulse 1.6s ease-in-out infinite;
}
@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
