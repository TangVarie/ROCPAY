page {
  background: #f5f6f8;
  color: #1a1a1a;
  font-size: 30rpx;
}
.container {
  padding: 48rpx 40rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
}
.btn-primary[disabled] {
  background: #9bd9b3;
  color: #fff;
}
.muted {
  color: #8a8a8a;
  font-size: 26rpx;
}
