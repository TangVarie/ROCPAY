/* 状态页：两个页面共 14 处，版式统一成一套（v6.3） */

/* 加载：版式未知的整页等待，山形弧带居中 */
.state {
  padding: 160rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.state-t1 { margin-top: 40rpx; font-size: 30rpx; font-weight: 600; color: var(--color-text-dark); text-align: center; }
.state-t2 { margin-top: 8rpx; font-size: 26rpx; line-height: 1.6; color: var(--color-text-light); text-align: center; }

/* 出错 / 空 / 无权限：浅青块（方法与说明），左对齐；标题 d3、说明 sm、细节 mi */
.emp {
  margin-top: 8rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--radius-container);
  background: var(--color-tint-primary);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.emp-t1 { font-size: 34rpx; line-height: 1.4; font-weight: 900; color: var(--color-text-dark); }
.emp-t2 { margin-top: 8rpx; font-size: 26rpx; line-height: 1.6; color: var(--color-text); }
.emp-detail {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-light);
  word-break: break-all;
  max-height: 200rpx;
  overflow: hidden;
}
/* 三个类名：组件样式和 app.wxss 的先后不确定，权重要高过 app.wxss 的 .btn:not([size='mini']) */
.emp .btn.emp-btn {
  margin-top: 32rpx;
  margin-left: 0;
  height: auto;
  min-height: 80rpx;
  padding: 12rpx 32rpx;
  box-sizing: border-box;
}
