/* 开屏：青面（承诺与识别）+ 墨字三档（token 见 app.wxss）。青面两模式同值，墨字也不翻转。
   全屏覆盖在页面之上，不在 .stagger-in 容器内（fixed 浮层放级联容器外）。
   通栏铺满视口，没有角可圆（DESIGN §六）；无阴影、无渐变——它本身就是一块底色，靠留白成形。 */
.splash {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 64rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-field-brand);
  color: var(--color-ink);
  animation: splashIn var(--duration-sm) var(--ease-out) backwards;
}
/* 离场比进场短，用离场曲线；时长与 splash.js 的 LEAVE_MS（240）一致，导航栏在它结束后才还原 */
.splash-leave { animation: splashOut 240ms var(--ease-in) forwards; }
@keyframes splashIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes splashOut { from { opacity: 1; } to { opacity: 0; } }

/* 轮印落角落（scenarios/04：启动页角落一枚，墨色）。kit 的 .round-seal 默认 text-dark，
   深色模式会翻成白——青面上一律墨，这里压回 --color-ink */
.splash-seal {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  color: var(--color-ink);
}

/* 一句话是整屏唯一的主角：d1 档、衬线时刻（BRAND.md §四；小程序不加载网络字体，走系统衬线栈），左对齐。
   一句话的进场：淡入先到、位移后落（CRAFT §一），只这一次 */
.splash-body { animation: splashIn 360ms var(--ease-out) 120ms backwards, splashRise var(--duration-lg) var(--ease-out-strong) 120ms backwards; }
@keyframes splashRise { from { transform: translateY(24rpx); } to { transform: translateY(0); } }
.splash-line {
  font-family: 'Songti SC', 'Noto Serif SC', 'Source Han Serif SC', 'STSong', 'SimSun', serif;
  font-size: 56rpx;
  line-height: 1.3;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: var(--color-ink);
}
.splash-foot {
  margin-top: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--color-ink-3); /* 青面注档 4.7:1 */
}

/* 超过最短停留仍在等页面数据：底部亮山形弧带 + 一句话。弧带默认主色，深色模式是亮青，
   在青面上会消失——改跟随墨字 */
.splash-wait {
  position: absolute;
  left: 0; right: 0;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: splashIn var(--duration-sm) var(--ease-out) backwards;
}
.splash-wait .band-spinner .band { background: currentColor; }
.splash-wait-t {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-ink-2);
}

/* 跳过：右下角，青面上的次动作——墨字 + 墨 14% 线框、控件圆角，热区 88rpx；按下底色加深一档 */
.splash-skip {
  position: absolute;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-width: 88rpx;
  height: 88rpx;
  line-height: 86rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: 1px solid var(--color-line-on-field);
  border-radius: var(--radius-control);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-align: center;
  color: var(--color-ink);
  transition: background-color var(--duration-press) var(--ease-out);
}
.splash-skip.is-press { background: var(--color-line-on-field); }

@media (prefers-reduced-motion: reduce) {
  .splash, .splash-wait { animation: splashIn 150ms var(--ease-out) backwards; }
  .splash-body { animation: splashIn 150ms var(--ease-out) backwards; }
  .splash-leave { animation: splashOut 150ms var(--ease-in) forwards; }
}
