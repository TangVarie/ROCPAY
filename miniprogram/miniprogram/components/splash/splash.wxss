/* 开屏：青面（品牌面色）+ 墨字。青面两模式同值，墨字也不翻转（token 见 app.wxss）。
   全屏覆盖在页面之上，不在 .stagger-in 容器内（DESIGN.md §6：fixed 浮层放级联容器外）。
   无阴影、无渐变、直角——它本身就是一块色，靠留白与对称成形。 */
.splash {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-field-brand);
  color: var(--color-ink);
  animation: splashIn 240ms ease-out backwards;
}
.splash-leave { animation: splashOut 240ms ease-in forwards; }
@keyframes splashIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes splashOut { from { opacity: 1; } to { opacity: 0; } }

/* 轮印落角落（scenarios/04：启动页角落一枚，墨色）。kit 的 .round-seal 默认 text-dark，
   深色模式会翻成白——青面上一律墨，这里压回 --color-ink */
.splash-seal {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  color: var(--color-ink);
}

/* 一句话是整屏的主角：品牌衬线时刻（BRAND.md §5：界面轨每页 ≤1 处；小程序不加载网络字体，走系统衬线栈），
   21px 导语档 */
.splash-line {
  font-family: 'Songti SC', 'Noto Serif SC', 'STSong', 'SimSun', serif;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}
.splash-foot {
  margin-top: 24rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  opacity: 0.65; /* 墨字 9.85:1，降到 65% 仍 >4.5:1；层级差只来自透明度 */
}

/* 超过最短停留仍在等页面数据：底部亮山形弧带 + 一句话。弧带默认主色，深色模式是亮青，
   在青面上会消失——改跟随墨字 */
.splash-wait {
  position: absolute;
  left: 0; right: 0;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: splashIn 240ms ease-out backwards;
}
.splash-wait .band-spinner .band { background: currentColor; }
.splash-wait-t {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.65;
}

@media (prefers-reduced-motion: reduce) {
  .splash, .splash-leave, .splash-wait { animation: none; }
}
