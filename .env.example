# ============================================================
#  小程序 + 云托管 · 商家转账 环境变量模板
#  用法：复制为 .env 后填入真实值（.env 不要提交到 Git）
#  cp .env.example .env
#  （部署到微信云托管时，把这些填到「云托管 → 服务 → 环境变量」里）
# ============================================================

# ====== 微信支付配置 ======
# 商户号（纯数字，如 1234567890）
WECHATPAY_MCHID=1234567890

# APIv3 密钥（必须正好 32 位字符）
# 位置：商户平台 → 账户中心 → API安全 → APIv3密钥
WECHATPAY_API_V3_KEY=A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6

# 【商户证书序列号】用于给请求签名（别和平台证书序列号搞混）
# 位置：商户平台 → 账户中心 → API安全 → API证书 → 查看证书
WECHATPAY_MERCHANT_CERT_SERIAL=1DDE55AD98ED71D6EDD4A4A16996DE57B6FA181C

# 商户私钥文件路径（相对 server/ 或绝对路径）。把 apiclient_key.pem 放到 server/cert/ 下
WECHATPAY_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
# 【云托管/serverless 推荐】把整个 apiclient_key.pem 用 base64 塞进一个变量，无换行无转义烦恼：
#   base64 -w0 apiclient_key.pem            # Linux
#   base64 apiclient_key.pem | tr -d '\n'   # macOS
# WECHATPAY_PRIVATE_KEY_BASE64=<上面命令输出的一长串>
# 或直接贴 PEM 内容（多行需把换行替换成 \n）：
# WECHATPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# 转账用 AppID —— 必须是你的【小程序 AppID】（收款人 openid 也来自这个小程序）
# 位置：小程序后台 → 开发管理 → 开发设置 → AppID(小程序ID)
# 别忘了在【商户平台 → AppID授权管理】里把这个小程序关联到商户号
WECHATPAY_APPID=wx1234567890abcdef

# 转账场景ID —— 新版必填！在【商户平台 → 产品中心 → 商家转账】申请开通对应场景后获得
# 常见：1000(现金营销)/1005(佣金报酬)/1006(企业报销) 等，以你申请到的为准
WECHATPAY_TRANSFER_SCENE_ID=1000

# 商家转账回调地址（部署到云托管后填，形如 https://<你的云托管域名>/api/notify）
WECHATPAY_NOTIFY_URL=

# ====== 平台验签/加密（二选一，都留空则自动下载平台证书）======
# 方式A（推荐·微信支付公钥）：商户平台 → API安全 → 微信支付公钥
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
# 方式B（平台证书）：以上留空时，程序用 APIv3 密钥自动下载并解密平台证书

# ====== 发奖励业务配置 ======
# 员工(管理员)的小程序 openid 白名单，逗号分隔
# （员工先用小程序打开，页面会显示他自己的 openid，把它填到这里，他才有权生成奖励）
ADMIN_OPENIDS=

# 奖励领取令牌的签名密钥：随便一串足够长的随机字符串，务必修改
REWARD_TOKEN_SECRET=please-change-me-to-a-long-random-string

# 领取链接有效期（小时）
REWARD_TTL_HOURS=72

# 单笔转账金额上限（元），保护阈值
MAX_AMOUNT_YUAN=5000

# 单笔转账金额下限（元）。微信商家转账有系统最低单笔额度，低于它会被拒（报"超过单笔转账上下限"）。
# 这里提前拦截、前端直接提示，避免白跑一趟微信。按你实际最低额调整（常见 0.1~0.3）。
MIN_AMOUNT_YUAN=0.1

# ====== 业务库（微信云托管自带 MySQL）======
# 留空 = 不建库、退回无状态模式（转账仍可用）。
# 二选一填写：
#   方式① 一行连接串（推荐，最省事）：
# MYSQL_URL=mysql://root:你的密码@10.x.x.x:3306/rocpay
#   方式② 分开填（在云托管 MySQL「连接信息」里抄内网地址/账号/密码）：
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rocpay
# 连接池大小（低频场景 5 足够）
MYSQL_POOL_SIZE=5
# 启动时自动建表（true=自动创建 rewards/transfers/notify_events；设 false 则手动跑 db/schema.sql）
DB_AUTO_MIGRATE=true

# ====== 服务器配置 ======
PORT=3000

# ====== （可选·将来用企微把领取链接自动发给客户时再填）======
# WECOM_CORPID=
# WECOM_CONTACT_SECRET=
